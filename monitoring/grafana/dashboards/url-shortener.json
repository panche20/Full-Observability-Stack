{
  "dashboard": {
    "id": null,
    "uid": "url-shortener-golden-signals",
    "title": "URL Shortener — Golden Signals",
    "description": "The four golden signals for URL Shortener service",
    "tags": ["url-shortener", "golden-signals", "sre"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "🚦 Request Rate (Traffic)",
        "description": "Requests per second — shows traffic volume",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{kubernetes_namespace='url-shortener'}[5m])) by (endpoint)",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 2,
        "title": "🔴 Error Rate",
        "description": "Percentage of requests returning 5xx errors",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "100 * sum(rate(http_requests_total{kubernetes_namespace='url-shortener', status_code=~'5..'}[5m])) / sum(rate(http_requests_total{kubernetes_namespace='url-shortener'}[5m]))",
            "legendFormat": "Error Rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "⏱️ Latency (p50 / p95 / p99)",
        "description": "Request duration percentiles",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{kubernetes_namespace='url-shortener'}[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{kubernetes_namespace='url-shortener'}[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{kubernetes_namespace='url-shortener'}[5m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "s"}
        }
      },
      {
        "id": 4,
        "title": "💾 Saturation — Memory Usage",
        "description": "Memory usage vs limit",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "container_memory_working_set_bytes{namespace='url-shortener', container='app'}",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "bytes"}
        }
      },
      {
        "id": 5,
        "title": "📊 URLs Shortened (Business Metric)",
        "description": "Total URLs shortened — business KPI",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum(urls_shortened_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "short", "color": {"mode": "thresholds"}}
        }
      },
      {
        "id": 6,
        "title": "🔴 Redis Connected",
        "description": "1 = connected, 0 = disconnected",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16},
        "targets": [
          {
            "expr": "redis_connected{kubernetes_namespace='url-shortener'}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "DOWN", "color": "red"}}, "type": "value"},
              {"options": {"1": {"text": "UP", "color": "green"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "id": 7,
        "title": "🔄 Active Requests",
        "description": "Currently in-flight requests",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum(http_active_requests{kubernetes_namespace='url-shortener'})",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "🔄 Pod CPU Usage",
        "description": "CPU usage per pod",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace='url-shortener', container='app'}[5m])) by (pod)",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "percentunit"}
        }
      },
      {
        "id": 9,
        "title": "📈 Redis Errors",
        "description": "Redis operation errors by type",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "rate(redis_errors_total{kubernetes_namespace='url-shortener'}[5m])",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ]
      }
    ],
    "schemaVersion": 38,
    "version": 1
  },
  "overwrite": true,
  "folderId": 0
}
